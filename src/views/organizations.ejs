<%- include('partials/header') %>

<main id="main-content">
    <div class="page">
        <h1 class="page__title"><%= title %></h1>
        <p class="lead">Here are a few of our partner organizations. Choose one to see everything it has coming up.</p>

        <ul class="directory">
            <% organizations.forEach((organization) => { %>
                <li class="directory__row">
                    <img class="directory__logo" src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">
                    <div class="directory__body">
                        <h2 class="directory__name">
                            <a href="/organization/<%= organization.organization_id %>"><%= organization.name %></a>
                        </h2>
                        <p class="directory__description"><%= organization.description %></p>
                        <a class="directory__contact" href="mailto:<%= organization.contact_email %>"><%= organization.contact_email %></a>
                    </div>
                </li>
            <% }); %>
        </ul>
    </div>
</main>

<%- include('partials/footer') %>
