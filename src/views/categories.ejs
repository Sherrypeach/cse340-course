<%- include('partials/header') %>

<main id="main-content">
    <div class="page">
        <h1 class="page__title"><%= title %></h1>
        <p class="lead">Every project on the network belongs to one of these categories. Pick the kind of work that fits you best.</p>

        <ul class="grid">
            <% categories.forEach((category) => { %>
                <li class="grid__item">
                    <h2 class="grid__name"><%= category.name %></h2>
                    <p class="grid__description"><%= category.description %></p>
                </li>
            <% }); %>
        </ul>
    </div>
</main>

<%- include('partials/footer') %>
