<%- include('partials/header') %>

<main id="main-content">
    <div class="page">
        <p class="crumb"><a href="/categories">Service project categories</a></p>

        <h1 class="page__title"><%= categoryDetails.name %></h1>
        <p class="lead">Service projects in this category.</p>

        <% if (projects.length > 0) { %>
            <ul class="stack">
                <% projects.forEach((project) => { %>
                    <li class="stack__item">
                        <h2 class="stack__name">
                            <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                        </h2>
                        <p class="stack__description"><%= project.description %></p>
                        <p class="stack__meta">
                            <%= project.project_date %> &mdash;
                            <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
                        </p>
                    </li>
                <% }); %>
            </ul>
        <% } else { %>
            <p class="empty">There are no service projects in this category yet.</p>
        <% } %>
    </div>
</main>

<%- include('partials/footer') %>
